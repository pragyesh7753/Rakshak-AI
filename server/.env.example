PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/rakshak_ai

CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx

REDDIT_USER_AGENT=rakshak-ai
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

HUGGINGFACE_API_KEY=your_huggingface_api_key
HUGGINGFACE_API_BASE_URL=https://router.huggingface.co/hf-inference/models
HF_MINILM_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_XLMR_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
HF_XLMR_MAX_CHARS=1200
HF_XLMR_FALLBACK_MAX_CHARS=500

GROQ_API_KEY=your_groq_api_key
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=700

HF_INFERENCE_BATCH_SIZE=5
GROQ_REASONING_CAP_PER_CYCLE=20
BORDERLINE_MIN_SCORE=5.5
BORDERLINE_MAX_SCORE=7.2
CONTEXT_AMBIGUITY_CONFIDENCE=58
MINILM_SIMILARITY_GAP_THRESHOLD=0.035
SENTIMENT_AMBIGUITY_CONFIDENCE=0.55

RUN_PIPELINE_ON_START=false
PIPELINE_CRON=*/20 * * * *