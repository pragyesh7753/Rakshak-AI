PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/rakshak_ai

CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx

HUGGINGFACE_API_KEY=your_huggingface_api_key
HUGGINGFACE_API_BASE_URL=https://router.huggingface.co/hf-inference/models
HF_MINILM_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_XLMR_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
HF_XLMR_MAX_CHARS=1200
HF_XLMR_FALLBACK_MAX_CHARS=500

GROQ_API_KEY=your_groq_api_key
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=700

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3-flash-preview

HF_INFERENCE_BATCH_SIZE=5
GROQ_REASONING_CAP_PER_CYCLE=20
BORDERLINE_MIN_SCORE=5.5
BORDERLINE_MAX_SCORE=7.2
CONTEXT_AMBIGUITY_CONFIDENCE=58
MINILM_SIMILARITY_GAP_THRESHOLD=0.035
SENTIMENT_AMBIGUITY_CONFIDENCE=0.55

ORG_KEYWORD_MAX_CANDIDATES=120
ORG_KEYWORD_MAX_FINAL=45
ORG_KEYWORD_MIN_SIMILARITY=0.18
ORG_QUERY_MAX_PER_ORG=14
REDDIT_QUERY_MAX_PER_CYCLE=140
ORG_EMBEDDING_MIN_SIMILARITY=0.21
ORG_EMBEDDING_MAX_MATCHES=8

RUN_PIPELINE_ON_START=false
PIPELINE_CRON=*/20 * * * *
ENABLE_PIPELINE_CRON_IN_DEV=false

RUN_DOMAIN_INTELLIGENCE_ON_START=false
DOMAIN_INTELLIGENCE_CRON=0 */6 * * *
DOMAIN_INTELLIGENCE_MAX_CANDIDATES_PER_ORG=120
DOMAIN_INTELLIGENCE_CONCURRENCY=3
DOMAIN_INTELLIGENCE_NETWORK_TIMEOUT_MS=12000
DOMAIN_INTELLIGENCE_SIMILARITY_THRESHOLD=0.82
DOMAIN_INTELLIGENCE_HIGH_RISK_THRESHOLD=70
DOMAIN_INTELLIGENCE_SOCIAL_SCAN_LIMIT=80
DOMAIN_INTELLIGENCE_SOCIAL_SAMPLE_LIMIT=5